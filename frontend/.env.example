VITE_API_URL=http://localhost:8000/api

# Bypass de login para desarrollar el frontend sin backend local (el PHP se
# construye directo en el subdominio cuando haya acceso al hosting).
# Poner en "false" (o quitar el archivo .env) en cuanto haya backend real que probar.
VITE_MOCK_AUTH=false
# Rol simulado cuando VITE_MOCK_AUTH=true: "admin" o "presupuestos"
VITE_MOCK_ROLE=admin
