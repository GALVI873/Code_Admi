# Copiar a ".env" en esta misma carpeta y completar con los valores reales.
# ".env" nunca debe compartirse ni subirse a ningún repositorio.

# Credenciales OAuth (tipo "App de escritorio") del proyecto de Google Cloud
# galvi-panel-integraciones — ver consola.cloud.google.com con la cuenta galviadmi@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ID de la carpeta de Drive a sincronizar (el segmento después de /folders/ en la URL)
GOOGLE_DRIVE_FOLDER_ID=

# Para push_to_panel.js: URL base del API del panel y el mismo SYNC_TOKEN
# configurado en backend/.env del servidor.
PANEL_API_URL=https://administracion.galvi.es/api
SYNC_TOKEN=
