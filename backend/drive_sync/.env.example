# Copiar a ".env" en esta misma carpeta y completar con los valores reales.
# ".env" nunca debe compartirse ni subirse a ningún repositorio.

# Credenciales OAuth (tipo "App de escritorio") del proyecto de Google Cloud
# galvi-panel-integraciones — ver consola.cloud.google.com con la cuenta galviadmi@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ID de la carpeta de Drive a sincronizar (el segmento después de /folders/ en la URL)
GOOGLE_DRIVE_FOLDER_ID=
# ID de la carpeta "Enviados por mail" — respaldo para completar Cliente/RAL/
# Vidrio/Persiana cuando la hoja "Ficha" del Excel interno viene vacía.
GOOGLE_DRIVE_ENVIADOS_FOLDER_ID=

# ID de la carpeta ".../SEGUIMIENTO DE OBRAS (Aceptadas)/2026" — usada por
# sync_obras_aceptadas.js (workspace de Alfredo).
GOOGLE_DRIVE_OBRAS_ACEPTADAS_FOLDER_ID=
# ID del archivo "1. Diario General Galvi.xlsx" (no una carpeta: es un único
# archivo fijo) — usado por sync_diario_general.js.
GOOGLE_DRIVE_DIARIO_GENERAL_FILE_ID=

# Para push_to_panel.js: URL base del API del panel y el mismo SYNC_TOKEN
# configurado en backend/.env del servidor.
PANEL_API_URL=https://administracion.galvi.es/api
SYNC_TOKEN=
