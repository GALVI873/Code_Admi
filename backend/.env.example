# Copiar a ".env" en esta misma carpeta y completar con los valores reales.
# ".env" nunca debe compartirse ni subirse a ningún repositorio.

# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Token para autorizar public/api/setup.php (inicializar la base de datos SQLite
# y crear usuarios por HTTP, ya que el hosting solo da acceso por FTP, sin SSH).
# Generar igual que el JWT_SECRET. Cambiar o borrar setup.php del servidor
# despues de terminar la configuracion inicial.
SETUP_TOKEN=

# Orígenes permitidos para llamadas del frontend (React), separados por coma.
# En producción el frontend se sirve del mismo origen (administracion.galvi.es),
# así que esto solo importa para desarrollo local (Vite en localhost:5173).
CORS_ALLOWED_ORIGINS=https://administracion.galvi.es,http://localhost:5173
