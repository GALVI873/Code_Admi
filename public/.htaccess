# Panel Galvi — el frontend es una SPA (React Router con rutas "limpias":
# /inicio, /prioridades, /obras-aceptadas/12...). Esas rutas no existen
# como archivos en el servidor, así que al recargar la página o abrir un
# enlace directo Apache devolvía 404. Cualquier ruta que no sea un archivo
# o carpeta real (y no esté bajo /api) se sirve con index.html y React
# Router muestra la página que corresponde. Pedido 2026-10-01.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^index\.html$ - [L]

    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
